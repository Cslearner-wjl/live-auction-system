# Server
SERVER_PORT=3000
NODE_ENV=development

# Web clients
ADMIN_WEB_URL=http://localhost:5173
MOBILE_WEB_URL=http://localhost:5174
PROD_ADMIN_WEB_URL=http://localhost:8080
PROD_MOBILE_WEB_URL=http://localhost:8081
PUBLIC_API_BASE_URL=http://localhost:3000

# Database and cache
DATABASE_URL=mysql://auction:change_me@127.0.0.1:3307/live_auction
REDIS_URL=redis://localhost:6379

# Bid lock and consistency workers
BID_LOCK_TTL_MS=15000
BID_LOCK_WAIT_TIMEOUT_MS=10000
BID_LOCK_RETRY_DELAY_MS=25
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_MAX_PUBLISH_ATTEMPTS=5
AUCTION_CONSISTENCY_WORKER_ENABLED=true
AUCTION_CONSISTENCY_INTERVAL_MS=30000
AUCTION_CONSISTENCY_RECENT_WINDOW_MS=86400000
AUCTION_CONSISTENCY_BATCH_SIZE=200

# docker-compose local services
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=live_auction
MYSQL_USER=auction
MYSQL_PASSWORD=change_me

# docker-compose.prod.yml host ports. Defaults avoid colliding with dev compose.
MYSQL_PORT=13307
REDIS_PORT=16379

# Optional AI provider. Keep real values in .env only.
AI_PROVIDER_BASE_URL=
AI_API_KEY=
AI_MODEL=
